//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 1000
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 4>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 1>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        tolayer0_mkp: tolayer0_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&mkp>, <&to_layer_0>;

            display-name = "MT_KP_MKP";
        };

        kp_mkp: kp_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&mkp>, <&kp>;

            display-name = "MT_KP_MKP";
            label = "KP_MKP";
        };

        mt_print_screen: mt_print_screen {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_PRINT_SCREEN";
            bindings = <&print_screen>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
        };

        mm_del: mm_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 1>;

            label = "MKP_EXIT_AML";
        };

        switch_lang: switch_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp CAPS>,
                <&macro_release>,
                <&kp LSHIFT>;
        };

        print_screen: print_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp LWIN>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp LWIN>;

            label = "PRINT_SCREEN";
        };

        bracket1: bracket1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "BRACKET1";
        };

        bracket2: bracket2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "BRACKET2";
        };

        bracket3: bracket3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BRACKET3";
        };

        email_template: email_template {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp T &kp U &kp K &kp A &kp R &kp E &kp S &kp A &kp M &kp A &kp D &kp E &kp S &kp U &kp DOT &kp SPACE &kp ENTER &kp ENTER &kp ENTER &kp Y &kp O &kp R &kp O &kp S &kp H &kp I &kp K &kp U &kp O &kp N &kp E &kp G &kp A &kp I &kp S &kp H &kp I &kp M &kp A &kp S &kp U &kp DOT &kp SPACE &kp ENTER &kp ENTER &kp S &kp A &kp K &kp O &kp SPACE &kp ENTER &kp ENTER &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW>;
            label = "EMAIL_TEMPLATE";
        };

        administrator: administrator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp D &kp M &kp I &kp N &kp I &kp S &kp T &kp R &kp A &kp T &kp O &kp R>;
            label = "ADMINISTRATOR";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        switch_lang {
            bindings = <&switch_lang>;
            key-positions = <36 45>;
        };

        middle_click {
            bindings = <&mkp MB3>;
            key-positions = <65 66>;
        };

        kana {
            bindings = <&kp F13>;
            key-positions = <45 46>;
        };

        eisu {
            bindings = <&kp F14>;
            key-positions = <36 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC     &kp N1      &kp N2  &kp N3  &kp N4        &kp N5                                   &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                 &kp NUMBER_6  &kp N7  &kp N8     &kp N9         &kp N0             &mt COLON SEMICOLON
&kp TAB     &kp Q       &kp W   &kp E   &kp R         &kp T                                    &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY               &kp Y         &kp U   &kp I      &kp O          &kp P              &mm_del
&kp LCTRL   &kp A       &kp S   &kp D   &kp F         &kp G         &mt_print_screen 0 CAPS    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &trans     &kp H         &kp J   &kp K      &kp_mkp MB4 L  &kp_mkp MB5 MINUS  &kp SQT
&kp LSHIFT  &kp Z       &kp X   &kp C   &kp V         &kp B         &trans                     &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &trans     &kp N         &kp M   &kp COMMA  &kp DOT        &kp FSLH           &kp BACKSLASH
&mo 2       &kp C_MUTE          &mo 4   &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE                                                                          &kp ENTER  &mo 3                                                              &mo 5
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC  &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                       &trans  &trans  &trans  &trans                       &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8     &to_layer_0 N9       &to_layer_0 N0           &to_layer_0 MINUS
&to_layer_0 TAB  &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                        &trans  &trans  &trans  &trans                       &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I      &to_layer_0 O        &to_layer_0 P            &to_layer_0 BACKSPACE
&kp LCTRL        &to_layer_0 A   &to_layer_0 S   &to_layer_0 D   &to_layer_0 F   &to_layer_0 G   &trans               &trans  &trans  &trans  &trans    &trans             &to_layer_0 H   &to_layer_0 J   &to_layer_0 K      &tolayer0_mkp MB4 L  &tolayer0_mkp MB5 MINUS  &to_layer_0 SEMICOLON
&kp LSHIFT       &to_layer_0 Z   &to_layer_0 X   &to_layer_0 C   &to_layer_0 V   &to_layer_0 B   &trans               &trans  &trans  &trans  &trans    &trans             &to_layer_0 N   &to_layer_0 M   &to_layer_0 COMMA  &mkp MB1             &mkp MB2                 &lt 2 BACKSLASH
&trans           &kp C_MUTE                      &trans          &kp LEFT_WIN    &kp LEFT_ALT    &to_layer_0 SPACE                                      &to_layer_0 ENTER  &trans                                                                                           &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &kp F1      &kp F2   &kp F3  &kp F4  &kp F5               &trans  &trans  &trans  &trans            &kp F6        &kp F7  &kp F8  &kp F9  &kp F10    &none
&trans  &kp F11     &kp F12  &none   &trans  &bracket1            &trans  &trans  &trans  &trans            &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp PLUS   &kp BACKSPACE
&trans  &none       &none    &none   &trans  &bracket2  &none     &trans  &trans  &trans  &trans    &none   &kp SLASH     &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&trans  &none       &none    &none   &trans  &bracket3  &none     &trans  &trans  &trans  &trans    &none   &kp COLON     &kp N1  &kp N2  &kp N3  &kp EQUAL  &none
&trans  &kp C_MUTE           &trans  &trans  &trans     &trans                                      &trans  &kp N0                                           &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &trans      &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans        &trans    &trans        &trans     &trans           &trans
&trans  &trans      &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &kp LA(F1)    &trans    &kp UP_ARROW  &trans     &kp KP_MULTIPLY  &kp DELETE
&trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &kp C_VOL_UP  &kp LEFT  &kp DOWN      &kp RIGHT  &kp KP_MINUS     &none
&trans  &trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &kp C_VOL_DN  &kp HOME  &kp INSERT    &kp END    &kp KP_PLUS      &none
&trans  &kp C_MUTE          &trans  &trans  &trans  &trans                                      &trans  &kp DEL                                                           &studio_unlock
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_BRI_INC C_BRIGHTNESS_DEC>;
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none         &none  &none  &none
&trans  &studio_unlock  &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &kp C_VOL_UP  &none  &none  &none
&trans  &none           &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &kp C_VOL_DN  &none  &none  &none
&trans  &none           &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &kp C_MUTE    &none  &none  &none
&trans  &trans                        &trans        &trans        &trans        &trans                                      &trans    &trans                                             &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        shortcut_layer {
            bindings = <
&trans  &trans          &trans  &trans           &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &email_template  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &administrator  &trans  &trans           &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans           &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                  &trans           &trans  &trans  &trans                                      &trans  &trans                                  &trans
            >;

            label = "shortcut";
        };
    };
};
